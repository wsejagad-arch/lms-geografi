# Aplikasi
PORT=3000
NODE_ENV=production

# Kunci penandatangan cookie sesi.
# Buat dengan: openssl rand -hex 32
# Beberapa kunci dipisahkan koma bila ingin rotasi (kunci pertama dipakai untuk menandatangani).
SESSION_SECRET=ganti-dengan-hasil-openssl-rand-hex-32

# Redis (opsional). Tanpa Redis, cache memakai memori proses.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
