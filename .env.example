# Aplikasi
PORT=3000
NODE_ENV=production

# Kunci penandatangan cookie sesi.
# Buat dengan: openssl rand -hex 32
# Beberapa kunci dipisahkan koma bila ingin rotasi (kunci pertama dipakai untuk menandatangani).
SESSION_SECRET=ganti-dengan-hasil-openssl-rand-hex-32

# Redis (opsional). Tanpa Redis, cache memakai memori proses.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Lokasi database JSON (opsional, default: data/db.json).
# Dipakai test otomatis agar tidak menyentuh data asli.
LMS_DB_PATH=

# Akun admin awal (dipakai saat data/db.json masih kosong).
# Bila ADMIN_PASSWORD kosong, password acak dibuat & dicetak sekali ke stdout.
ADMIN_EMAIL=admin@lms.id
ADMIN_PASSWORD=

# Rate limit login (default: 5 percobaan gagal per 15 menit per IP+identifier).
# Butuh Redis agar berlaku lintas proses PM2; tanpa Redis hanya per proses.
LOGIN_MAX_FAILS=5
LOGIN_WINDOW_MS=900000

# Panel User Aktif: ambang "online" dan seberapa sering last_seen diperbarui.
SESSION_ONLINE_MS=120000
SESSION_TOUCH_MS=30000
