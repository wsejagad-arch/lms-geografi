{
  "servers": {
    "browser": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${workspaceFolder}/scripts/browser-mcp.mjs"
      ],
      "env": {
        "BROWSER_HEADLESS": "1",
        "BROWSER_PORT": "9333",
        "BROWSER_TIMEOUT_MS": "20000"
      }
    },
    "hermes": {
      "type": "stdio",
      "command": "python",
      "args": [
        "${workspaceFolder}/scripts/hermes_mcp.py"
      ],
      "env": {
        "HERMES_BASE_URL": "https://inference-api.nousresearch.com/v1",
        "HERMES_MODEL": "reflection/beam-1.0-501b-a23b:free",
        "HERMES_TIMEOUT_MS": "300000",
        "HERMES_AUTH_PROVIDER": "nous"
      }
    }
  }
}
