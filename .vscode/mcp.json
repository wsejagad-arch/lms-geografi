{
  "inputs": [
    {
      "id": "hermesApiKey",
      "type": "promptString",
      "description": "Hermes API key (isi dari ~/.hermes/.env -> API_SERVER_KEY)",
      "password": true
    }
  ],
  "servers": {
    "hermes": {
      "type": "stdio",
      "command": "python3",
      "args": ["${workspaceFolder}/scripts/hermes_mcp.py"],
      "env": {
        "HERMES_BASE_URL": "http://127.0.0.1:8642/v1",
        "HERMES_MODEL": "hermes-agent",
        "HERMES_API_KEY": "${input:hermesApiKey}"
      }
    }
  }
}